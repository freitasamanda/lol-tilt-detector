# ==============================================================================
# CONFIGURAÇÕES DO PROJETO - DETECTOR DE TILT (LEAGUE OF LEGENDS)
# ==============================================================================
# Como usar:
# 1. Faça uma cópia deste arquivo e renomeie para ".env" (sem o .example)
# 2. Gere sua chave gratuita em: https://developer.riotgames.com/
# 3. Cole sua chave no campo RIOT_API_KEY abaixo
# ⚠️ NUNCA suba o seu arquivo ".env" real para o GitHub!

# Sua chave de API da Riot Games (começa com RGAPI-)
RIOT_API_KEY=RGAPI-sua-chave-aqui

# Roteamento regional da API Account-v1 e Match-v5
# Opções válidas: americas, europe, asia, sea
# (Para servidores do Brasil, América do Norte e LATAM, mantenha "americas")
RIOT_REGION=americas

# Plataforma/Servidor específico do jogador (opcional, usado para consultas futuras)
# Opções: BR1, NA1, LA1, LA2, EUW1, KR
RIOT_PLATFORM=BR1